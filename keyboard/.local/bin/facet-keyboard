#!/usr/bin/env python3
"""facet-keyboard – lighting, Fn keys and per-key colors of keyboards from Linux, without the vendor app

Which keyboards: one file per board in ~/.local/share/facet/keyboard/boards (the registry),
the protocol of each board family in .../keyboard/families. The board is the one plugged in, or
the one picked with `facet-keyboard board <id>` (facet keyboard set), or --board.
Protocol notes per board: docs/boards/ in the keyboard repo.

NOTHING IS SENT UNLESS --live IS GIVEN. Without it every command only prints the packets it
would send (dry run); reads are skipped and replaced by placeholder blocks. Before each write
in live mode the current block is read back, checked and saved under
${XDG_STATE_HOME:-~/.local/state}/facet/keyboard/, so `restore` can put it back.

Usage:
  facet-keyboard boards [text] | board [<id>] | detect   the registry, the board in use, what is plugged in
  facet-keyboard list                          keyboards and dongles found (sysfs only, sends nothing)
  facet-keyboard keys | effects | actions      key names / built-in effects / what fn accepts
  facet-keyboard info [--layer fn1]            device id, lighting config and a key layer
  facet-keyboard backup                        save every block the board has
  facet-keyboard restore <file>                write a saved block back
  facet-keyboard effect <name> [-b N] [-s N] [-c slot|multi|color]
                                               switch the built-in effect (a color goes into the table)
  facet-keyboard fn <key>=<action> ...         set Fn-layer keys (--layer fn1|fn2|base)
  facet-keyboard fn --show | --reset <key>...  print the layer / put keys back to the factory Fn action
  facet-keyboard colors [--all C] <key>=C ...  per-key colors, kept on the keyboard; keys not named keep theirs
  facet-keyboard style solid|split|rows [--keep-effect]
                                               per-key style from the facet theme
  facet-keyboard highlight <key[=C]...> [-c C] [--base C] [--hold | --seconds N | --stdin] [--skip-unknown]
                                               light keys live (RAM only, nothing saved), then stop
  facet-keyboard stop                          end a live frame, back to the saved effect
  facet-keyboard udev                          udev rules for every board in the registry

Keys use the names of the hotkey overlay (xkb names, lower case): q, return, space, super_l,
f5, prior ... `--layout de` reads them as QWERTZ (z, y, ssharp, udiaeresis ...).
Colors: #rrggbb, rrggbb, a theme role (primary, accent, ...) or red/green/blue/white/off.

Options for every command: --live (really send), --board <id>, --hidraw /dev/hidrawN,
--verbose (print the packets in live mode too), --theme <name>, --layout us|de, --json.
"""
import argparse
import contextlib
import importlib
import json
import os
import select
import signal
import sys
import time
from pathlib import Path


def data_dir():
    """The registry next to this script in the keyboard module (the link in ~/.local/bin leads
    there), or the linked copy in ~/.local/share"""
    env = os.environ.get("FACET_KEYBOARD_DATA")
    for d in ([Path(env)] if env else []) + [
            Path(os.path.realpath(__file__)).parents[1] / "share/facet/keyboard",
            Path.home() / ".local/share/facet/keyboard"]:
        if (d / "kblib.py").is_file():
            return d
    sys.exit("facet-keyboard: the board registry is missing (~/.local/share/facet/keyboard); "
             "facet update keyboard")


# No __pycache__ inside the module (it is a git checkout)
sys.dont_write_bytecode = True
sys.path.insert(0, str(data_dir()))
import kblib  # noqa: E402
from kblib import Fail, label, parse_color, theme_colors  # noqa: E402

FAMILIES = {}


def family(name):
    if name not in FAMILIES:
        try:
            FAMILIES[name] = importlib.import_module("families." + name.replace("-", "_"))
        except ImportError as e:
            raise Fail(f"no protocol code for the board family '{name}' ({e})")
    return FAMILIES[name]


def table_driver(board):
    """A driver that only knows the board's tables (keys, effects, actions); opens nothing"""
    d = family(board.family).Driver.__new__(family(board.family).Driver)
    d.live = False
    d.use(board)
    return d


def need(board, what, cap):
    if not board.can.get(cap):
        raise Fail(f"the {board.name} has no {what} in facet-keyboard (yet)")


# ---------------------------------------------------------------- registry commands

def cmd_boards(a, boards):
    text = " ".join(a.text)
    hits = [b for b in boards.values() if b.matches(text)] if text else list(boards.values())
    hits.sort(key=lambda b: (b.vendor.lower(), b.name.lower()))
    if a.json:
        return [b.summary() for b in hits]
    if not hits:
        print(f"no board matches '{text}'. Ask for yours: {kblib.REQUEST_URL}")
    for b in hits:
        state = "tested" if b.tested else "untested"
        print(f"{b.id:18} {b.name:24} {', '.join(f'{v:04x}:{p:04x}' for v, p, _ in b.usb):22} {b.family} ({state})")


def layout_json(board, layout):
    rows = [[{"id": k, "label": label(k, layout) if k else "", "w": w} for k, w in row] for row in board.layout]
    return {**board.summary(), "rows": rows, "keys": board.keys, "source": board.data.get("source", "")}


def cmd_board(a, boards):
    if a.id:
        if a.id not in boards:
            close = [b.id for b in boards.values() if b.matches(a.id)]
            raise Fail(f"unknown board '{a.id}'" + (f"; did you mean {', '.join(close)}?" if close else
                                                    " (facet-keyboard boards)"))
        kblib.save_board(a.id)
        if not a.json:
            print(f"board: {boards[a.id].name} ({a.id}), saved in {kblib.CHOICE_FILE}")
            return
    b = kblib.select_board(boards, a.id or a.board, quiet=a.json)
    if a.json:
        return {**layout_json(b, a.layout), "saved": kblib.saved_board()}
    print(f"{b.name} ({b.id}), family {b.family}, {'tested' if b.tested else 'untested: dry run until you tried it'}")
    print(f"source: {b.data.get('source', '?')}")
    print(f"notes: {b.data.get('notes', '-')}")


def cmd_detect(a, boards):
    found = kblib.connected_boards(boards)
    out = [{"board": b.id, "name": b.name, "usb": f"{v:04x}:{p:04x}", "link": link} for b, v, p, link in found]
    if a.json:
        return out
    if not out:
        print("no keyboard from the registry is plugged in")
    for d in out:
        print(f"{d['usb']}  {d['link']:6}  {d['name']} ({d['board']})")
    ids = {d["usb"] for d in out}
    if any(sum(1 for d in out if d["usb"] == u) > 1 for u in ids):
        print("several boards share this USB id; the device id tells them apart once --live is used. "
              "Pick yours: facet keyboard set <board>")


def cmd_udev(a, boards):
    print("# facet keyboards: hidraw access for facet-keyboard without root, for whoever sits at the seat.")
    print("# Written by `facet add keyboard` / `facet update keyboard` from the board registry")
    print("# (facet-keyboard udev); udev does not follow links into $HOME, so it is a copy.")
    seen = set()
    for b in sorted(boards.values(), key=lambda b: b.id):
        for v, p, link in b.udev:
            if (v, p) in seen:
                continue
            seen.add((v, p))
            names = sorted({x.name for x in boards.values() if (v, p) in [(u[0], u[1]) for u in x.usb]})
            print(f"# {', '.join(names)} ({link})")
            print(f'KERNEL=="hidraw*", ATTRS{{idVendor}}=="{v:04x}", ATTRS{{idProduct}}=="{p:04x}", TAG+="uaccess"')


def cmd_list(a, boards):
    ids = {}
    for b in boards.values():
        for v, p, link in b.usb:
            ids.setdefault((v, p), (link, []))[1].append(b)
    out = []
    for node, vid, pid, iface, desc in kblib.hidraw_nodes(set(ids)):
        link, owners = ids[(vid, pid)]
        fam = family(owners[0].family)
        out.append({"node": node, "usb": f"{vid:04x}:{pid:04x}", "kind": link, "interface": iface,
                    "config": bool(fam.is_config(desc, link)), "boards": [b.id for b in owners]})
    if a.json:
        return out
    if not out:
        print("no keyboard or dongle from the registry found (facet-keyboard boards)")
    for n in out:
        kind = "keyboard on the USB cable" if n["kind"] == "wired" else "2.4 GHz dongle"
        role = "  <- configuration interface" if n["config"] else ""
        print(f"{n['node']}  {n['usb']}  {kind}, interface {n['interface']}{role}")


# ---------------------------------------------------------------- board commands

def cmd_keys(a, board):
    rows = [[k for k, _ in row if k] for row in board.layout]
    if a.json:
        return {"board": board.id, "rows": rows, "slots": board.keys,
                "labels": {k: label(k, a.layout) for k in board.keys}}
    print(board.name)
    for row in rows:
        print("  ".join(row))
    extra = sorted(set(board.keys) - {k for r in rows for k in r})
    if extra:
        print("also: " + " ".join(extra))
    print("\n--layout de: " + ", ".join(f"{k} = {v}" for k, v in kblib.LAYOUT_DE.items()))


def cmd_effects(a, board):
    need(board, "built-in effects", "effects")
    effects = table_driver(board).effects_json()
    if a.json:
        return effects
    print("effect         speed  color")
    for e in effects:
        print(f"{e['name']:14} {'yes' if e['speed'] else '-':6} {'yes' if e['color'] else '-'}")
    print(f"\nbrightness 0-{board.can.get('brightness', '?')}, speed 0-{board.can.get('speed', '?')}, color: "
          "slot 0-6 of the effect's row in the color table, multi, or any color (it goes into slot 0)")


def cmd_actions(a, board):
    """What `fn` accepts besides keys and combos, for front ends."""
    need(board, "Fn layer", "fn")
    out = table_driver(board).actions_json()
    if a.json:
        return out
    for group, names in out.items():
        if group != "defaults":
            print(f"{group}: {' '.join(names)}")


def layout_rows(board):
    return [[k for k, _ in row if k] for row in board.layout]


def cmd_colors(a, drv):
    need(drv.board, "per-key colors", "perkey")
    theme = theme_colors(a.theme)
    colors = {}
    if a.all:
        rgb = parse_color(a.all, theme)
        colors = {s: rgb for s in drv.slots.values()}
    for item in a.items:
        if "=" not in item:
            raise Fail(f"'{item}': write key=color, e.g. w=red")
        key, color = item.split("=", 1)
        colors[drv.slot_of(key, a.layout)] = parse_color(color, theme)
    if not colors:
        raise Fail("no keys given (colors w=red a=red ... or --all <color>)")
    drv.perkey(a, colors)


def cmd_style(a, drv):
    need(drv.board, "per-key colors", "perkey")
    theme = theme_colors(a.theme)
    role = lambda r, fallback: parse_color(theme.get(r, fallback), {})
    primary, secondary, accent = role("primary", "#5d6fe8"), role("secondary", "#93a4f7"), role("accent", "#a48cf2")
    colors = {}
    if a.name == "solid":
        colors = {s: primary for s in drv.slots.values()}
    elif a.name == "split":
        mods = {"tab", "caps_lock", "shift_l", "control_l", "super_l", "alt_l", "fn", "control_r",
                "shift_r", "return", "backspace", "delete", "prior", "next", "end", "knob", "grave",
                "home", "insert", "alt_r", "super_r", "menu", "print", "scroll_lock", "pause", "hangul"}
        for name, slot in drv.slots.items():
            if name in ("esc", "up", "down", "left", "right"):
                colors[slot] = accent
            elif name in mods or name.startswith("kp_") or name.startswith("f") and name[1:].isdigit():
                colors[slot] = secondary
            else:
                colors[slot] = primary
    else:  # rows: accent at the edges, primary in the middle
        rows = layout_rows(drv.board)
        for i, row in enumerate(rows):
            edge = min(i, len(rows) - 1 - i)
            rgb = accent if edge == 0 else secondary if edge == 1 else primary
            for name in row:
                colors[drv.slots[name]] = rgb
    drv.perkey(a, colors)


def highlight_keys(drv, items, lit, base, theme, layout, skip_unknown):
    """Slot colors for `key` (in lit) and `key=color`; `color=C` and `base=C` set those two."""
    colors = {}
    for item in items:
        key, _, color = item.partition("=")
        if key == "color" and color:
            lit = parse_color(color, theme)
            continue
        if key == "base" and color:
            base = parse_color(color, theme)
            continue
        try:
            slot = drv.slot_of(key, layout)
        except Fail:
            # with --skip-unknown, names that are no key on the board (mouse binds, print …)
            # are left out instead of failing
            if skip_unknown:
                continue
            raise
        colors[slot] = parse_color(color, theme) if color else lit
    return colors, lit, base


def cmd_highlight(a, drv):
    need(drv.board, "live frames", "live")
    theme = theme_colors(a.theme)
    lit = parse_color(a.color or theme.get("primary", "white"), theme)
    base = parse_color(a.base or theme.get("bg", "off"), theme)
    if not a.keys and not a.stdin:
        raise Fail("highlight: name at least one key (or read them with --stdin)")
    colors, lit, base = highlight_keys(drv, a.keys, lit, base, theme, a.layout, a.skip_unknown)
    if not drv.live and not a.stdin:
        drv.frame(colors, base)
        print(f"[dry-run] live, this frame goes out again every {drv.frame_interval:g} s until the time is up "
              "or the process gets SIGTERM/SIGINT, then the stop packet:")
        drv.frame_stop()
        return
    stop = []
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: stop.append(True))
    until = None if a.hold or a.stdin else time.monotonic() + a.seconds
    # A --hold whose starter is gone (the shell crashed) would light the keys for ever
    parent = os.getppid()
    # --stdin is read straight from the descriptor: Python's buffered readline can take two
    # lines at once and leave the second where select() no longer sees it
    fd = sys.stdin.fileno()
    pending = b""

    def over():
        return bool(stop) or (until is not None and time.monotonic() >= until) or os.getppid() != parent

    try:
        while not over():
            drv.frame(colors, base)
            resend = time.monotonic() + drv.frame_interval
            while not over() and time.monotonic() < resend:
                if not a.stdin:
                    time.sleep(0.05)
                    continue
                # --stdin: every line is a new key list (same words as on the command line),
                # an empty line only the base color, end of input ends the frame
                ready, _, _ = select.select([fd], [], [], 0.05)
                if not ready:
                    continue
                data = os.read(fd, 4096)
                if not data:
                    stop.append(True)
                    break
                *lines, pending = (pending + data).split(b"\n")
                if not lines:
                    continue
                # Only the newest list matters when several came at once
                line = lines[-1].decode("utf-8", "replace")
                try:
                    colors, lit, base = highlight_keys(drv, line.split(), lit, base, theme, a.layout, a.skip_unknown)
                except Fail as e:
                    print(f"facet-keyboard: {e}", file=sys.stderr, flush=True)
                    continue
                break  # the new frame goes out right away
    finally:
        drv.frame_stop()


def cmd_info(a, drv):
    return drv.info(a)


def cmd_backup(a, drv):
    drv.backup_all(a)


def cmd_restore(a, drv):
    drv.restore(a)


def cmd_effect(a, drv):
    need(drv.board, "built-in effects", "effects")
    drv.effect(a, theme_colors(a.theme), parse_color)


def cmd_fn(a, drv):
    need(drv.board, "Fn layer", "fn")
    if a.layer not in drv.board.can.get("layers", []):
        raise Fail(f"the {drv.board.name} has no layer {a.layer} (layers: {', '.join(drv.board.can.get('layers', []))})")
    drv.fn(a)


def cmd_stop(a, drv):
    need(drv.board, "live frames", "live")
    drv.frame_stop()


# ---------------------------------------------------------------- main

def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--live", action="store_true", help="really talk to the keyboard (default: dry run)")
    common.add_argument("--dry-run", action="store_true", help="only print the packets (the default)")
    common.add_argument("--board", help="board id from the registry (default: plugged in or saved)")
    common.add_argument("--hidraw", help="use this /dev/hidrawN")
    common.add_argument("--verbose", "-v", action="store_true", help="print the packets in live mode too")
    common.add_argument("--force-model", action="store_true", help=argparse.SUPPRESS)
    common.add_argument("--layout", choices=["us", "de"],
                        default=os.environ.get("FRAME_KEYBOARD_LAYOUT", "us").lower()[:2],
                        help="read key names as US or German (QWERTZ) layout")
    common.add_argument("--theme", help="facet theme for color roles (default: the active one)")
    common.add_argument("--json", action="store_true", help="JSON on stdout (boards, board, detect, list, keys, effects, actions, info)")

    p = argparse.ArgumentParser(prog="facet-keyboard", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("list", "detect", "udev", "keys", "effects", "actions", "backup", "stop"):
        sub.add_parser(name, parents=[common])
    s = sub.add_parser("boards", parents=[common])
    s.add_argument("text", nargs="*", help="only boards whose vendor, name or id contain these words")
    s = sub.add_parser("board", parents=[common])
    s.add_argument("id", nargs="?", help="save this board as yours")
    s = sub.add_parser("info", parents=[common])
    s.add_argument("--layer", choices=["base", "fn1", "fn2", "tap"], default="fn1")
    s = sub.add_parser("restore", parents=[common])
    s.add_argument("file")
    s = sub.add_parser("effect", parents=[common])
    s.add_argument("name")
    s.add_argument("-b", "--brightness", type=int)
    s.add_argument("-s", "--speed", type=int)
    s.add_argument("-c", "--color", help="slot 0-6, multi, or a color")
    s = sub.add_parser("fn", parents=[common])
    s.add_argument("items", nargs="*")
    s.add_argument("--layer", choices=["base", "fn1", "fn2", "tap"], default="fn1")
    s.add_argument("--show", action="store_true")
    s.add_argument("--reset", action="store_true", help="put the named keys back to the factory Fn action")
    s.add_argument("--allow-knob", action="store_true")
    s.add_argument("--action-layout", choices=["us", "de"],
                   help="layout for key names in actions only (keys stay as --layout reads them)")
    for name in ("colors", "style"):
        s = sub.add_parser(name, parents=[common])
        if name == "colors":
            s.add_argument("items", nargs="*")
            s.add_argument("--all")
        else:
            s.add_argument("name", choices=["solid", "split", "rows"])
            s.add_argument("--keep-effect", action="store_true",
                           help="only store the colors unless self-define is the effect already")
        s.add_argument("-b", "--brightness", type=int)
    s = sub.add_parser("highlight", parents=[common])
    s.add_argument("keys", nargs="*", help="key or key=color")
    s.add_argument("--stdin", action="store_true",
                   help="hold, and take new key lists from stdin, one per line (the shell's hotkey hints)")
    s.add_argument("-c", "--color")
    s.add_argument("--base")
    s.add_argument("--skip-unknown", action="store_true", help="leave out names that are no key on the board")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--hold", action="store_true", help="until SIGTERM / Ctrl+C")
    g.add_argument("--seconds", type=float, default=3.0)
    a = p.parse_args()

    if a.live and a.dry_run:
        p.error("--live and --dry-run exclude each other")
    # With --json the report goes to stdout and everything else to stderr
    out = sys.stdout
    try:
        with contextlib.redirect_stdout(sys.stderr if a.json else sys.stdout):
            boards = kblib.load_boards()
            if a.cmd in ("boards", "board", "detect", "udev", "list"):
                result = {"boards": cmd_boards, "board": cmd_board, "detect": cmd_detect,
                          "udev": cmd_udev, "list": cmd_list}[a.cmd](a, boards)
            elif a.cmd in ("keys", "effects", "actions"):
                board = kblib.select_board(boards, a.board, quiet=True)
                result = {"keys": cmd_keys, "effects": cmd_effects, "actions": cmd_actions}[a.cmd](a, board)
            else:
                board = kblib.select_board(boards, a.board)
                if not a.live:
                    print(f"dry run: nothing is sent to the keyboard (add --live to send); board {board.name}",
                          flush=True)
                elif not board.tested:
                    print(f"note: the {board.name} support is untested; stop at the first surprise "
                          f"({board.data.get('notes', 'docs/boards')})", flush=True)
                drv = family(board.family).Driver(board, boards, a.live, a.hidraw, a.verbose, a.force_model)
                result = {"info": cmd_info, "backup": cmd_backup, "restore": cmd_restore,
                          "effect": cmd_effect, "fn": cmd_fn, "colors": cmd_colors, "style": cmd_style,
                          "highlight": cmd_highlight, "stop": cmd_stop}[a.cmd](a, drv)
        if a.json:
            print(json.dumps(result), file=out)
        return 0
    except (Fail, OSError) as e:
        print(f"facet-keyboard: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
